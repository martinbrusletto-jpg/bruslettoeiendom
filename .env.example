# BytePlus ModelArk. Settes som miljøvariabler på Netlify, ikke i repoet.
# Lokalt: kopier til .env og fyll inn nøkkelen fra Ark-konsollen.

BYTEPLUS_API_KEY=

# Valgfritt — standardverdiene brukes hvis disse står tomme.
BYTEPLUS_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
BYTEPLUS_MODEL=seed-2-0-pro-260328

# Valgfri ekstra sperre: settes den, må kall sende headeren x-byteplus-token.
BYTEPLUS_CLIENT_TOKEN=

# Komma-separerte origins utover eget domene og *.netlify.app.
BYTEPLUS_ALLOWED_ORIGINS=

BYTEPLUS_MAX_TOKENS=1024
BYTEPLUS_RATE_LIMIT=20
BYTEPLUS_TIMEOUT_MS=25000
